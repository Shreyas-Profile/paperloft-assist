# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — it never leaves your machine.
#
# Everything under "Required" has to be set or env.ts refuses to boot
# (it zod-parses at import time). "Optional" gates specific features —
# the app boots without them but the matching feature is disabled.

# --- Required: core ---------------------------------------------------

# Random 32-byte string for session cookies. Generate:
#   openssl rand -base64 32
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
AUTH_SECRET=

# Where the app runs. localhost:3000 in dev, https://paperloft.uk in prod.
# Both names exist because Auth.js reads AUTH_URL and legacy Google OAuth
# callbacks read NEXTAUTH_URL — keep them the same.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Postgres connection string. In dev, run the local docker Postgres via
# `docker compose -f docker-compose.dev.yml up -d` (see README) and use:
#   postgresql://admin:admin@localhost:5432/paperloft_assist
DATABASE_URL=

# --- Required: LLM ----------------------------------------------------

# https://openrouter.ai/keys — one key, all providers.
OPENROUTER_API_KEY=

# OpenRouter model id for text chat. Voice transcription is hardcoded
# to google/gemini-2.5-flash regardless of what this is set to.
# Good defaults: anthropic/claude-haiku-4.5, deepseek/deepseek-v4-pro
MODEL=anthropic/claude-haiku-4.5

# --- Required: Google OAuth ------------------------------------------

# Google Cloud Console → Paperloft → APIs & Services → Credentials.
# Add http://localhost:3000/api/auth/callback/google as an authorised
# redirect URI for dev; add https://paperloft.uk/... for prod.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Required: symmetric encryption for BYO skill secrets -------------

# Any 32-byte hex string. NEVER rotate without wiping the UserSkill
# table — existing rows encrypted with the old key become unreadable.
#   openssl rand -hex 32
USER_SKILL_ENCRYPTION_KEY=

# --- Optional: Telegram bot (@PaperloftAssistantBot in prod) ---------

# BotFather token — https://t.me/BotFather → /newbot → paste the token.
TELEGRAM_BOT_TOKEN=

# Bot username WITHOUT the @. Shown on sign-in + used to build the
# reminder-delivery deep-link.
TELEGRAM_BOT_USERNAME=

# Random string used to authenticate Telegram's webhook POST calls.
# Set webhook to https://<host>/api/telegram/bot-webhook/<this>.
#   openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# --- Optional: hosted skill MCPs (Globalion infra) -------------------

# docs.regiq.in — RAG over uploaded documents.
DOCS_MCP_URL=https://docs.regiq.in
DOCS_MCP_UPLOAD_URL=https://docs.regiq.in/api/documents/upload
DOCS_MCP_PLATFORM_SECRET=

# tor.regiq.in — anonymous HTTP fetch through Tor exits.
TOR_MCP_URL=https://tor.regiq.in
TOR_MCP_PLATFORM_SECRET=

# cron.regiq.in — hosted cron scheduling with HMAC-signed webhooks.
CRON_MCP_URL=https://cron.regiq.in
CRON_MCP_KEY=
CRON_CALLBACK_URL=https://paperloft.uk/api/cron/fire
CRON_WEBHOOK_SIGNING_SECRET=
# Legacy cron secret still used by /api/cron/reminders.
CRON_SECRET=

# browser-mcp — hosted Chrome. Off by default in v0.2 (see CHANGELOG).
BROWSER_MCP_URL=
BROWSER_MCP_KEY=

# video-render.regiq.in — Fireship-style motion-graphics video generation.
# Shared paperloft-service key (no per-user provisioning yet); jobs are
# tagged with metadata.userEmail for accounting.
VIDEO_RENDER_MCP_URL=https://video-render.regiq.in/api/mcp
VIDEO_RENDER_MCP_KEY=

# --- Optional: WhatsApp (deprecated, kept as backdoor) ---------------

# Sign-in via WhatsApp was removed in v0.2. Send path still works —
# leave blank if you don't need it.
WASENDER_API_KEY=
WHATSAPP_WEBHOOK_SECRET=

# --- Optional: admin --------------------------------------------------

# Comma-separated emails that get admin flags on the /skills page.
ADMIN_EMAILS=you@example.com

# Local disk root for user-attached files (prescription PDFs, etc.).
# Defaults to /data/users. In prod a docker volume mounts here.
USERFILES_ROOT=/data/users
